# Tasks produce 1 MiB outputs (DataSize is in bytes) and allocate 10 MiB (MemorySize is in KiB)
HtcMock__NTasks=500
HtcMock__TotalCalculationTime=00:10:00.100
HtcMock__DataSize=1048576
HtcMock__MemorySize=10240
HtcMock__SubTasksLevels=3
HtcMock__Partition=default
HtcMock__EnableSmallOutput=false
HtcMock__EnableUseLowMem=false
