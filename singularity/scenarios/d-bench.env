# Throughput benchmark: many instantaneous tasks so that the graph generation and the tail become negligible.
# 20 levels keep about NTasks/20 = 1000 dependencies per aggregation task: with 3 levels, one aggregation gets
# ~6500 dependencies and the agent crashes with a stack overflow (ArmoniK.Core TaskTable.RemoveRemainingDataDependenciesAsync).
HtcMock__NTasks=20000
HtcMock__TotalCalculationTime=00:10:00.100
HtcMock__DataSize=1
HtcMock__MemorySize=1
HtcMock__SubTasksLevels=20
HtcMock__Partition=default
