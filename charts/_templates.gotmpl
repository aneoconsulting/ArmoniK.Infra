{{- /*
  Overrides of helm-docs built-in templates, same names. Definitions only, so
  helm-docs still renders its default README body. Every construct trims its
  whitespace: text outside a definition would be prepended to that body.
*/ -}}

{{- /*
  Escapes pipes for a table cell. A pipe splits a markdown row even inside a code
  span, and helm-docs emits Default and Description raw, so a default holding a
  template pipeline (most conf defaults) would spill into the next column.
*/ -}}
{{- define "armonik.escapePipes" -}}
{{ . | replace "|" "\\|" }}
{{- end -}}

{{- /*
  The built-in chart.valuesTable with its cells escaped. Its whitespace mirrors
  the built-in one exactly; keep it that way.
*/ -}}
{{- define "chart.valuesTable" -}}
{{ if .Sections.Sections }}{{ range .Sections.Sections }}

### {{ .SectionName }}

| Key | Type | Default | Description |
|-----|------|---------|-------------|
  {{- range .SectionItems }}
| {{ .Key }} | {{ .Type }} | {{ if .Default }}{{ template "armonik.escapePipes" .Default }}{{ else }}{{ template "armonik.escapePipes" .AutoDefault }}{{ end }} | {{ if .Description }}{{ template "armonik.escapePipes" .Description }}{{ else }}{{ template "armonik.escapePipes" .AutoDescription }}{{ end }} |  {{- end }}{{- end }}{{ if .Sections.DefaultSection.SectionItems}}

### {{ .Sections.DefaultSection.SectionName }}

| Key | Type | Default | Description |
|-----|------|---------|-------------|
  {{- range .Sections.DefaultSection.SectionItems }}
| {{ .Key }} | {{ .Type }} | {{ if .Default }}{{ template "armonik.escapePipes" .Default }}{{ else }}{{ template "armonik.escapePipes" .AutoDefault }}{{ end }} | {{ if .Description }}{{ template "armonik.escapePipes" .Description }}{{ else }}{{ template "armonik.escapePipes" .AutoDescription }}{{ end }} |  {{- end }}{{ end }}{{ else }}| Key | Type | Default | Description |
|-----|------|---------|-------------|
  {{- range .Values }}
| {{ .Key }} | {{ .Type }} | {{ if .Default }}{{ template "armonik.escapePipes" .Default }}{{ else }}{{ template "armonik.escapePipes" .AutoDefault }}{{ end }} | {{ if .Description }}{{ template "armonik.escapePipes" .Description }}{{ else }}{{ template "armonik.escapePipes" .AutoDescription }}{{ end }} |  {{- end }}{{ end }}{{ end -}}
