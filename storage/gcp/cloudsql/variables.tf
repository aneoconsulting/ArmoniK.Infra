variable "name" {
  description = "Name of the Cloud SQL instance: lowercase letters, digits or hyphens, starting with a letter. A deleted instance keeps its name reserved for up to a week, so a deployment destroyed and created again needs a new one (a random suffix, for example)."
  type        = string
  validation {
    condition     = can(regex("^[a-z]([-a-z0-9]{0,61}[a-z0-9])?$", var.name))
    error_message = "\"name\" must be up to 63 lowercase letters, digits or hyphens, start with a letter and not end with a hyphen."
  }
}

variable "region" {
  description = "Region of the instance, the one of the consumers. Defaults to the provider region."
  type        = string
  default     = null
}

variable "network" {
  description = "VPC the clients connect from, projects/<project>/global/networks/<name> or its self link. Cloud SQL creates a Private Service Connect endpoint in it, with a DNS record of the instance name (the host output), from the service connection policy of the network (psc_subnets)."
  type        = string
}

variable "psc_subnets" {
  description = "Subnets of network, in the region of the instance, where the Private Service Connect endpoints of Cloud SQL take their IP address: the module creates the service connection policy of the network for Cloud SQL with them. Empty when the network already has that policy (one per network, region and service class)."
  type        = list(string)
  default     = []
  nullable    = false
}

variable "database_version" {
  description = "PostgreSQL version of the instance. ArmoniK Core needs PostgreSQL 18 or later."
  type        = string
  default     = "POSTGRES_18"
  validation {
    condition     = can(regex("^POSTGRES_[0-9]+$", var.database_version))
    error_message = "\"database_version\" must be POSTGRES_<major version>."
  }
}

variable "edition" {
  description = "Cloud SQL edition, ENTERPRISE or ENTERPRISE_PLUS."
  type        = string
  default     = "ENTERPRISE"
  validation {
    condition     = contains(["ENTERPRISE", "ENTERPRISE_PLUS"], var.edition)
    error_message = "\"edition\" must be ENTERPRISE or ENTERPRISE_PLUS."
  }
}

variable "tier" {
  description = "Machine type of the instance: db-custom-<vCPUs>-<memory in MB> in the ENTERPRISE edition, db-perf-optimized-N-<vCPUs> in ENTERPRISE_PLUS."
  type        = string
  default     = "db-custom-2-8192"
}

variable "data_cache" {
  description = "Enable the data cache, reads served from a local SSD beyond the memory of the instance (ENTERPRISE_PLUS only, billed apart)."
  type        = bool
  default     = false
  nullable    = false
}

variable "connection_pooling" {
  description = <<-EOT
    Managed Connection Pooling (ENTERPRISE_PLUS only): poolers in front of the instance, on port 6432 of its host
    (pooler_port output), the server still answering on 5432 (port output). Turning it on or off restarts the instance.
    * enabled: deploy the poolers, one per 4 vCPUs of the tier.
    * flags: settings of the poolers, such as pool_mode (transaction by default), max_pool_size (server connections
      per database and user, per pooler, 50 by default), max_client_connections (per pooler, 5000 by default) or
      max_prepared_statements. See https://cloud.google.com/sql/docs/postgres/managed-connection-pooling.
  EOT
  type = object({
    enabled = optional(bool, false)
    flags   = optional(map(string), {})
  })
  default  = {}
  nullable = false
}

variable "availability_type" {
  description = "ZONAL, or REGIONAL for a standby in another zone with automatic failover (twice the price)."
  type        = string
  default     = "ZONAL"
  validation {
    condition     = contains(["ZONAL", "REGIONAL"], var.availability_type)
    error_message = "\"availability_type\" must be ZONAL or REGIONAL."
  }
}

variable "disk" {
  description = <<-EOT
    Data disk of the instance.
    * size: initial size in GB.
    * autoresize: grow the disk when it fills up, never shrinks.
    * type: PD_SSD or PD_HDD.
  EOT
  type = object({
    size       = optional(number, 20)
    autoresize = optional(bool, true)
    type       = optional(string, "PD_SSD")
  })
  default  = {}
  nullable = false
}

variable "database_flags" {
  description = "PostgreSQL flags of the instance, merged over the defaults of the module: cloudsql.logical_decoding = on, which the logical replication of ArmoniK Core needs, and max_connections = 500, since every Core process opens up to 100 connections. See https://cloud.google.com/sql/docs/postgres/flags."
  type        = map(string)
  default     = {}
  nullable    = false
}

variable "database" {
  description = "Name of the database of ArmoniK Core."
  type        = string
  default     = "armonik"
}

variable "user" {
  description = "Name of the PostgreSQL user of ArmoniK Core, owner of the database. Its password is generated by the module (password output)."
  type        = string
  default     = "armonik"
}

variable "backup" {
  description = <<-EOT
    Automated backups.
    * enabled: daily backup, kept for retained_backups days.
    * point_in_time_recovery: also keep the WAL, to restore any point in time within transaction_log_retention_days.
    * start_time: start of the backup window, HH:MM in UTC.
  EOT
  type = object({
    enabled                        = optional(bool, true)
    point_in_time_recovery         = optional(bool, false)
    start_time                     = optional(string)
    retained_backups               = optional(number, 7)
    transaction_log_retention_days = optional(number, 7)
  })
  default  = {}
  nullable = false
}

variable "maintenance_window" {
  description = "Weekly maintenance window: day from 1 (Monday) to 7 (Sunday), hour from 0 to 23 in UTC. Null lets Cloud SQL choose."
  type = object({
    day  = number
    hour = number
  })
  default = null
}

variable "deletion_protection" {
  description = "Block the deletion of the instance, by Terraform (deletion_protection) and through the API (deletion_protection_enabled)."
  type        = bool
  default     = true
}

variable "labels" {
  description = "Labels of the instance."
  type        = map(string)
  default     = {}
  nullable    = false
}

variable "monitoring_user" {
  description = "Name of a read-only PostgreSQL user for the monitoring tools, with pg_monitor and SELECT on the tables of the database (monitoring_password output). Null creates none."
  type        = string
  default     = "armonik_monitoring"
}

variable "query_insights" {
  description = "Enable Query Insights, the per-query statistics of the Cloud SQL console."
  type        = bool
  default     = true
}
