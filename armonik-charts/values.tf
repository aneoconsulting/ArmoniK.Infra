locals {
  reg = var.registries

  operators_values = {
    global = {
      armonik = {
        operators = {
          mongodbOperator    = { deploy = var.database_operators.mongodb }
          postgresqlOperator = { deploy = var.database_operators.postgresql }
        }
      }
    }
    external-secrets = {
      image          = { repository = "${local.reg.ghcr}/external-secrets/external-secrets" }
      webhook        = { image = { repository = "${local.reg.ghcr}/external-secrets/external-secrets" } }
      certController = { image = { repository = "${local.reg.ghcr}/external-secrets/external-secrets" } }
    }
    keda = {
      image = {
        keda             = { registry = local.reg.ghcr }
        metricsApiServer = { registry = local.reg.ghcr }
        webhooks         = { registry = local.reg.ghcr }
      }
    }
    cert-manager = {
      imageRegistry = local.reg.quay
    }
    kube-prometheus = {
      # The Prometheus Service is kps-prometheus (prometheus_url)
      fullnameOverride  = "kps"
      windowsMonitoring = { enabled = false }
      # No Alertmanager: this alert would fire forever
      defaultRules = { disabled = { PrometheusNotConnectedToAlertmanagers = true } }
      prometheusOperator = {
        image                    = { registry = local.reg.quay }
        prometheusConfigReloader = { image = { registry = local.reg.quay } }
        thanosImage              = { registry = local.reg.quay }
        admissionWebhooks        = { patch = { image = { registry = local.reg.ghcr } } }
      }
      prometheus               = { prometheusSpec = { image = { registry = local.reg.quay } } }
      prometheus-node-exporter = { image = { registry = local.reg.quay } }
      kube-state-metrics       = { image = { registry = local.reg.k8s } }
    }
  }

  prometheus_url = "http://kps-prometheus.${var.operators_namespace}.svc:9090"

  # The armonik release installs none: they come from the armonik-operators release
  operator = { deploy = false, available = true, namespace = var.operators_namespace }

  armonik_values = {
    global = {
      armonik = {
        operators = {
          externalSecrets    = local.operator
          keda               = local.operator
          certManager        = local.operator
          prometheusOperator = local.operator
          mongodbOperator    = merge(local.operator, { available = var.database_operators.mongodb })
          postgresqlOperator = merge(local.operator, { available = var.database_operators.postgresql })
        }
        monitoring = { prometheusUrl = local.prometheus_url }
        versions   = { for name, tag in var.versions : name => tag if tag != null }
      }
    }
    control-plane = {
      serviceAccount  = { create = true, name = var.service_accounts.control_plane }
      image           = { registry = local.reg.dockerhub }
      metricsExporter = { image = { registry = local.reg.dockerhub } }
      podDeletionCost = { image = { registry = local.reg.dockerhub } }
      init            = { image = { registry = local.reg.dockerhub } }
    }
    compute-plane = {
      serviceAccount = { create = true, name = var.service_accounts.compute_plane }
      init           = { image = { registry = local.reg.dockerhub } }
      fluentBit      = { image = { registry = local.reg.dockerhub } }
      partitionCommon = {
        agent  = { image = { registry = local.reg.dockerhub } }
        worker = { image = { registry = local.reg.dockerhub } }
      }
      partitions = {
        for name, p in var.partitions : name => {
          # Not below minReplicaCount (1), the chart drops it: one pod stays when idle
          hpa = { maxReplicaCount = p.max_replicas, idleReplicaCount = p.scale_to_zero ? 0 : 1 }
          worker = {
            image = {
              registry   = split("/", p.image)[0]
              repository = join("/", slice(split("/", p.image), 1, length(split("/", p.image))))
              tag        = p.tag
            }
            resources = {
              requests = { cpu = p.cpu, memory = p.memory }
              limits   = { cpu = coalesce(p.cpu_limit, p.cpu), memory = p.memory }
            }
          }
        }
      }
    }
    ingress = {
      image = { registry = local.reg.dockerhub }
      gui   = { image = { registry = local.reg.dockerhub } }
    }
    dependencies = {
      grafana = {
        image   = { registry = local.reg.dockerhub }
        sidecar = { image = { registry = local.reg.quay } }
        # Generated by the chart otherwise, anew at every render, which restarts Grafana
        admin = { existingSecret = kubernetes_secret_v1.grafana_admin.metadata[0].name }
      }
      # The same image on Docker Hub as on cr.fluentbit.io
      fluent-bit = { image = { repository = "${local.reg.dockerhub}/fluent/fluent-bit" } }
      seq        = { image = { repository = "${local.reg.dockerhub}/datalust/seq" } }
    }
  }
}
