{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    ":semanticCommitTypeAll(chore)",
    "helpers:pinGitHubActionDigests"
  ],
  "configMigration": true,
  "semanticCommits": "enabled",
  "lockFileMaintenance": {
    "enabled": true
  },
  "pre-commit": {
    "enabled": true
  },
  "helmfile": {
    "enabled": false
  },
  "rangeStrategy": "bump",
  "ignorePaths": [],
  "customManagers": [
    {
      "customType": "regex",
      "description": "ArmoniK component versions in the chart image map, which carry no image reference of their own.",
      "managerFilePatterns": [
        "/^charts/armonik-common/values\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>\\S+)(\\s+extractVersion=(?<extractVersion>\\S+))?\\s*\\n\\s*\\w+:\\s*\"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Chart appVersion, which is the tag of the images that chart deploys.",
      "managerFilePatterns": [
        "/^charts/[^/]+/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>\\S+)(\\s+extractVersion=(?<extractVersion>\\S+))?\\s*\\nappVersion:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ],
  "packageRules": [
    {
      "groupName": "other dependencies",
      "matchPackageNames": [
        "*"
      ]
    },
    {
      "description": "Hold third party releases for a few days, in case they get pulled or compromised; ArmoniK components opt out below.",
      "matchPackageNames": [
        "*"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "groupName": "github actions",
      "groupSlug": "github-actions",
      "matchDatasources": [
        "github-tags"
      ]
    },
    {
      "groupName": "pre-commit hooks",
      "groupSlug": "pre-commit",
      "matchManagers": [
        "pre-commit"
      ]
    },
    {
      "groupName": "third party images",
      "groupSlug": "third-party-images",
      "matchDatasources": [
        "docker"
      ]
    },
    {
      "groupName": "third party charts",
      "groupSlug": "third-party-charts",
      "matchDatasources": [
        "helm"
      ]
    },
    {
      "description": "Keep the Chart.yaml dependency ranges; in-range versions move through lock file maintenance of Chart.lock.",
      "matchManagers": [
        "helmv3"
      ],
      "rangeStrategy": "replace"
    },
    {
      "groupName": "terraform modules",
      "groupSlug": "terraform-module",
      "matchDatasources": [
        "terraform-module"
      ]
    },
    {
      "groupName": "terraform provider",
      "groupSlug": "terraform-provider",
      "matchDatasources": [
        "terraform-provider"
      ]
    },
    {
      "groupName": "terraform provider examples",
      "groupSlug": "terraform-provider examples",
      "matchFileNames": [
        "**/examples/**"
      ],
      "matchDatasources": [
        "terraform-provider"
      ]
    },
    {
      "groupName": "ArmoniK components",
      "groupSlug": "armonik",
      "matchDatasources": [
        "github-releases",
        "docker"
      ],
      "matchPackageNames": [
        "aneoconsulting/**",
        "dockerhubaneo/**"
      ],
      "minimumReleaseAge": null
    }
  ]
}
